# Azure SQL Database Connection (Production)
DB_SERVER=solutionarch.database.windows.net
DB_DATABASE=teneomemory
DB_USER=teneomemory_app
DB_PASSWORD=<USE_AZURE_KEY_VAULT>
DB_ENCRYPT=true

# NextAuth Configuration (Production)
NEXTAUTH_URL=https://teneo-memory-dashboard.azurewebsites.net
NEXTAUTH_SECRET=<GENERATE_NEW_SECRET_32_CHARS>

# Demo Users (Production - Update or remove)
DEMO_USERS=admin@teneo.ai:<NEW_SECURE_PASSWORD>

# Azure App Service Configuration
WEBSITES_PORT=3000
NODE_ENV=production
